# Normalize line endings in the repository; shell scripts and container files must stay LF
# because they run inside Linux containers even when checked out on Windows.
* text=auto
*.sh text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.conf text eol=lf
.dockerignore text eol=lf
*.ps1 text eol=crlf
*.gz binary
*.png binary
*.db binary
