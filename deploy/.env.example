# Optional overrides for deploy/compose.yaml (the one-command demo stack).
# Copy to deploy/.env, or export the variables, before scripts/demo-up. Every value has a
# demo default in compose.yaml, so this file is not required.
#
# DEMO MODE: the stack always runs the development profile with the development login. These
# overrides only replace the demo's publicly known secrets; they do not make it production-ready.

# Pepper for API keys and session tokens (at least 32 characters).
AEGIS_SECRET_KEY=change-me-to-a-random-string-of-at-least-32-chars

# PostgreSQL passwords: superuser (used once by `init`), schema owner, application role.
AEGIS_DEMO_SUPERUSER_PASSWORD=change-me
AEGIS_DEMO_OWNER_PASSWORD=change-me
AEGIS_DEMO_APP_PASSWORD=change-me
