# Aegis Environment Configuration (Example)

# LLM Configuration
# AEGIS_MODEL_PROFILE=development (development uses qwen3.5:4b)
# AEGIS_MODEL_PROFILE=research (research uses qwen3.5:9b)
AEGIS_MODEL_PROFILE=development

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_THINK=false

# Database Configuration
DATABASE_URL=sqlite:///./aegis.db

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Investigation Engine Limits
MAXIMUM_LLM_TURNS=7
MAXIMUM_TOOL_CALLS=12
MAXIMUM_INVESTIGATION_DURATION_SECONDS=210
MAXIMUM_EVIDENCE_ITEMS=30
MAXIMUM_CONTEXT_SIZE=24000

# Telemetry Endpoints (Examples, replace with actual endpoints per profile)
# PROMETHEUS_ENDPOINT=http://localhost:9090
# LOKI_ENDPOINT=http://localhost:3100
# TEMPO_ENDPOINT=http://localhost:3200
